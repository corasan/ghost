{
  "name": "ghost",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ghost": "bun packages/cli/src/main.ts",
    "build:cli": "bun run --cwd packages/cli build",
    "install:cli": "bun run --cwd packages/cli build --install",
    "server": "bun run ghost pair && bun run --cwd packages/server dev",
    "mobile": "bun run --cwd apps/mobile start",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "app:ios": "bun apps/mobile/scripts/install.ts ios",
    "app:android": "bun apps/mobile/scripts/install.ts android",
    "eas": "bun apps/mobile/scripts/eas.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "react-native-drawer-layout@4.2.11": "patches/react-native-drawer-layout@4.2.11.patch"
  }
}
