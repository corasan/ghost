{
  "name": "ghost",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "server": "bun run --cwd packages/server dev",
    "serve": "bun run --cwd packages/server serve",
    "mobile": "bun run --cwd apps/mobile start",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
