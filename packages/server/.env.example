# Interface to bind. Loopback only: Tailscale Serve (`bun run serve`) is what
# exposes the server to the tailnet, over https.
GHOST_HOST=127.0.0.1
GHOST_PORT=4848

# Where the SQLite file lives (relative to packages/server).
GHOST_DATA_DIR=./data

# Bungie application (https://www.bungie.net/en/Application)
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Model used by the Claude Agent SDK. Auth comes from your Claude Code login
# (`claude login`), so no API key is needed here.
GHOST_MODEL=claude-sonnet-5-5
